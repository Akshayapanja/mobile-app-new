{
  "expo": {
    "name": "Intants School ERP",
    "slug": "intants-mobile-app",
    "version": "1.0.0",
    "description": "School ERP Mobile App for Parents and Staff",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intants.schoolerp",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.intants.schoolerp"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "adad8102-25fd-46f6-9ca8-70372e2330f0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/adad8102-25fd-46f6-9ca8-70372e2330f0",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A90D9",
          "sounds": []
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#4A90D9",
      "androidMode": "default"
    }
  }
}
